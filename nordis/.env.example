# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# PostgreSQL
POSTGRES_USER=nordis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nordis
DATABASE_URL=postgresql+psycopg://nordis:change-me@db:5432/nordis

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Часовой пояс расчётов
NORDIS_TIMEZONE=Asia/Almaty

# Ключ шифрования API-ключей клиентов (Fernet). Хранится вне базы.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NORDIS_ENCRYPTION_KEY=

# Claude API (понадобится в спринте 2)
ANTHROPIC_API_KEY=
